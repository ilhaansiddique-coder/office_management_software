# Migration scripts read these PostgreSQL connection URLs from .env.
# Keep real connection strings in the ignored .env file only.
#
# SOURCE_DATABASE_URL:
#   Supabase dashboard > Project Settings > Database > Connection string > URI.
#   Use Direct connection or Session pooler. Replace the password placeholder
#   with the database password (not the anon/publishable API key), URL-encode
#   special characters, and add ?sslmode=require if missing.
#
# DATABASE_URL:
#   Local PostgreSQL destination on this PC. The database must exist first.
#   Use the local PostgreSQL password and URL-encode special characters.
#
#SOURCE_DATABASE_URL=postgresql://postgres:<encoded-password>@<supabase-db-host>:5432/postgres?sslmode=require
#DATABASE_URL=postgresql://postgres:<encoded-password>@127.0.0.1:5432/office_management
